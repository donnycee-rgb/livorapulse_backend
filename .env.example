# "Worth getting checked" flags stay off until their wording and support contacts are signed off
HEALTH_FLAGS_ENABLED=false

# EmailJS — sign-up codes and password reset links (sent from this server)
# In EmailJS → Account → Security, allow API calls from non-browser applications.
# Without these, development prints codes and links to the console; production refuses.
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_TEMPLATE_VERIFY=
EMAILJS_TEMPLATE_RESET=
