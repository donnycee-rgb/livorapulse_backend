generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  googleId     String?  @unique
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  preferences          UserPreferences?
  profile              UserProfile?
  physicalEntries      PhysicalActivityEntry[]
  digitalEntries       DigitalUsageEntry[]
  productivitySessions ProductivitySession[]
  moodLogs             MoodLog[]
  ecoActions           EcoAction[]
  dailySummaries       DailySummary[]
  refreshTokens        RefreshToken[]
  cycleLogs            CycleLog[]
  nutritionLogs        NutritionLog[]
  waterLogs            WaterLog[]
  dailyFeatures        DailyFeatures[]
  insights             Insight[]
  experiments          Experiment[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
}

model UserPreferences {
  id                   String  @id @default(cuid())
  userId               String  @unique
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                String  @default("dark")
  units                String  @default("metric")
  notificationsEnabled Boolean @default(true)
  focusMode            Boolean @default(false)
}

// Stores permanent onboarding profile data
model UserProfile {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth              DateTime?
  gender                   String? // 'male' | 'female' | 'non-binary' | 'prefer-not-to-say'
  heightCm                 Float?
  weightKg                 Float?
  hasDisability            Boolean   @default(false)
  disabilityNote           String?
  primaryGoal              String? // 'lose-weight' | 'gain-muscle' | 'better-sleep' | 'reduce-stress' | 'build-habits' | 'improve-fitness' | 'eco-lifestyle'
  onboardingComplete       Boolean   @default(false)
  // Calculated goals — stored so score system uses them
  goalStepsPerDay          Int?
  goalSleepHours           Float?
  goalScreenMinutes        Int?
  goalFocusMinutes         Int?
  goalEcoActionsPerDay     Int?
  goalSocialMinutes        Int?
  goalEntertainmentMinutes Int?
  goalCaloriesPerDay       Int?
  // Cycle defaults — saved from settings, used as fallback when < 2 cycles logged
  defaultCycleLength       Int?
  defaultPeriodDuration    Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model PhysicalActivityEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps        Int      @default(0)
  distanceKm   Float    @default(0)
  caloriesKcal Int      @default(0)
  sleepMinutes Int      @default(0)
  trail        Json?
  note         String?
  timestamp    DateTime @default(now())
}

model DigitalUsageEntry {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  screenTimeMinutes Int
  categoryBreakdown Json     @default("{}")
  date              DateTime @default(now())
}

model ProductivitySession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  label       String?
  startedAt   DateTime
  endedAt     DateTime
  durationSec Int
}

model MoodLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Each is null when the user didn't set it in this check-in — one tap
  // records one answer, never a leftover default for the other
  emoji       String?
  stressScore Int?
  note        String?
  timestamp   DateTime @default(now())
}

model EcoAction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  type        String
  impactKgCO2 Float
  timestamp   DateTime @default(now())
}

model DailySummary {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime
  insightText       String?
  physicalScore     Float?
  digitalScore      Float?
  productivityScore Float?
  moodScore         Float?
  ecoScore          Float?
  nutritionScore    Float?
  score             Int? // final weighted LifePulse score shown to the user that day
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, date])
}

model CycleLog {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStartDate   DateTime
  cycleLength       Int      @default(28)
  periodDuration    Int      @default(5)
  flowIntensity     String? // 'spotting' | 'light' | 'medium' | 'heavy'
  symptoms          Json? // string[] — cramps, bloating, fatigue, etc.
  notes             String?
  actualCycleLength Int? // calculated from gap between this and previous period
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model NutritionLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealType  String // 'breakfast' | 'lunch' | 'dinner' | 'snack'
  foodName  String
  calories  Float
  proteinG  Float    @default(0)
  carbsG    Float    @default(0)
  fatG      Float    @default(0)
  quantity  Float    @default(1)
  unit      String   @default("serving")
  timestamp DateTime @default(now())
}

model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  glasses   Int      @default(1)
  timestamp DateTime @default(now())
}

// One row per user per local (Nairobi) day: the values the insights engine
// analyses, derived nightly from the raw logs. Null always means "not logged",
// never zero. The rules for each field are in services/FeatureService.ts.
model DailyFeatures {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime // local day start, from utils/day.ts — same convention as DailySummary

  sleepMinutes         Int? // the night that ended on the morning of this day
  steps                Int? // steps on walks recorded with the walk tracker
  distanceKm           Float?
  activeCaloriesKcal   Int?
  screenMinutes        Int?
  socialMinutes        Int?
  entertainmentMinutes Int?
  focusMinutes         Int?
  studyMinutes         Int?
  moodValue            Float? // mean of the day's emojis mapped to 1–5
  stressScore          Float? // mean of the day's stress answers, 1–10 as stored
  caloriesIn           Float? // only on days with 2+ different meals logged
  proteinG             Float? // same rule as caloriesIn
  waterGlasses         Int?
  ecoActions           Int? // actions that saved CO₂; 0 when only 0 kg actions were logged
  cyclePhase           String?
  cycleDay             Int?
  symptoms             Json? // string[] logged with the period covering this day

  computedAt DateTime @default(now()) @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// A pattern found in one user's own data. Kept when it stops holding
// (status "stale") so it can come back without losing its history.
model Insight {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key             String // stable id, e.g. "sleepMinutes->stressScore:same-day"
  driver          String
  outcome         String
  lag             String // "same-day" | "next-day" | "same-night"
  direction       String // "positive" | "negative": does the outcome rise with the driver?
  effect          Float // meanHigh − meanLow, in the outcome's stored units
  strength        Float // effect beyond the weekday/weekend mix, in outcome SDs — for ranking
  rho             Float? // Spearman correlation; null for cycle phase
  groupLabelLow   String // e.g. "Under 6h sleep" (for cycle phase: the phase)
  groupLabelHigh  String // e.g. "6h+ sleep"     (for cycle phase: rest of cycle)
  meanLow         Float
  meanHigh        Float
  nDays           Int
  qValue          Float
  text            String // plain-language sentence shown to the user
  status          String   @default("active") // active | stale | dismissed
  feedback        String? // "useful" | "not-true" | null
  dismissedEffect Float? // effect when dismissed — it only returns if much stronger
  splitValue      Float? // the driver value the groups were split at (null for cycle phase)
  firstFoundAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId, status])
}

// A 14-day test of a change suggested by an insight. The result compares the
// insight's outcome during the experiment with the 14 days before it.
model Experiment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  insightKey    String // the pair being tested, e.g. "socialMinutes->focusMinutes:same-day"
  driver        String
  outcome       String
  lag           String
  change        String // what the user is trying, e.g. "Keep social media under 2h a day"
  baselineStart DateTime // local day starts (utils/day.ts), like DailyFeatures.date
  baselineEnd   DateTime
  startDate     DateTime
  endDate       DateTime // day 14
  status        String   @default("active") // active | completed | stopped
  result        Json? // filled in when completed — see services/ExperimentService.ts
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  checkins ExperimentCheckin[]

  @@index([userId, status])
}

// "Did you do it today?" — one answer per experiment day
model ExperimentCheckin {
  id           String     @id @default(cuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  date         DateTime // local day start
  did          Boolean
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([experimentId, date])
}
